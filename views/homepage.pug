doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
    link(rel="stylesheet" href="/css/style.css")
  body
    main.container
      h1 Custom Object Table

      a.add-link(href="/update-cobj") Add/Update this table

      if records && records.length > 0
        table
          thead
            tr
              th Name
              th Publisher
              th Price
          tbody
            each record in records
              tr
                td= record.properties.name || '—'
                td= record.properties.publisher || '—'
                td= record.properties.price || '—'
      else
        p.empty-state No records found. 
          a(href="/update-cobj") Add your first record →
