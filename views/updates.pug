doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
    link(rel="stylesheet" href="/css/style.css")
  body
    main.container
      a.back-link(href="/") ← Return to the homepage

      h1 Add a New Record

      form(action="/update-cobj" method="POST")
        .form-group
          label(for="name") Name *
          input#name(
            type="text"
            name="name"
            placeholder="e.g. Animal Crossing: New Horizons"
            required
          )

        .form-group
          label(for="publisher") Publisher
          input#publisher(
            type="text"
            name="publisher"
            placeholder="e.g. Nintendo"
          )

        .form-group
          label(for="price") Price
          input#price(
            type="text"
            name="price"
            placeholder="e.g. 60"
          )

        button(type="submit") Add to Table
